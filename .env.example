# Copy to .env and fill in real values. Never commit .env.

# --- LLM, primary provider: any OpenAI-compatible endpoint (we use the OpenAI SDK) ---
# Default: Groq free tier, ~10x faster than Gemini Flash-Lite in our tests (2-4s vs 15-44s).
# Key: https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# To use OpenAI instead:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini

# --- LLM, fallback provider (optional): tried once if the primary fails after retries ---
# Default: Google Gemini free tier. Slower, but a different company's infrastructure,
# so a Groq outage or rate limit doesn't stop the agent. Key: https://aistudio.google.com/apikey
# Leave LLM_FALLBACK_API_KEY empty to disable the fallback.
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite

# Sampling temperature for all LLM calls. 0 = most consistent output.
# Google recommends 1.0 for Gemini 3 models; raise it if you see looping or degraded output.
LLM_TEMPERATURE=0

# --- Web search ---
TAVILY_API_KEY=

LOG_LEVEL=INFO
